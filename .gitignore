# Data — never commit, always mount at runtime
data/
*.parquet
*.xlsx

# CSV data files — do NOT commit raw gateway / telemetry CSVs
# Exception: predictions.csv and backend/predictions.csv are submission artifacts and MUST be committed.
*.csv
!predictions.csv
!backend/predictions.csv

# Intermediate / broken prediction artefacts — do NOT commit
predictions_broken.csv
predictions_baseline.csv

# Model artifacts — JSON registry files ARE committed (they are the live demo evidence).
# models/*.json   ← committed intentionally
# drift_reports/  ← committed intentionally as MLOps evidence (schema-drift demo)
!drift_reports/*.json

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/
dist/
build/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
*.cover

# Virtual environments
.venv/
venv/
env/

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Secrets
.env
.env.local
*.pem

# DB
*.db
*.sqlite
