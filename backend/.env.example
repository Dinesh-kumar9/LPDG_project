# LPDG Gateway Prioritization — Environment Configuration
# Copy this file to .env and set LPDG_DATA_DIR to your local data directory.
# All variables are optional in Docker (set via docker-compose.yml).
# All variables are optional locally if you always pass --data on the CLI.

# ── Required for local development ─────────────────────────────────────────────
# Absolute path to the challenge dataset directory containing:
#   telemetry/month=YYYY-MM/*.parquet
#   gateway_master.csv
#   field_visits.csv
#   meter_read_success.csv
#   engineer_review_2026-02.xlsx
LPDG_DATA_DIR=/path/to/your/local/data

# ── Optional overrides (defaults shown) ────────────────────────────────────────

# Directory where model registry JSON files and ACTIVE pointer are stored.
# Default: models/ (relative to backend/ working directory)
# LPDG_MODELS_DIR=models

# Directory where drift monitor JSON reports are written.
# Default: ../drift_reports (relative to backend/ — i.e. project-root/drift_reports/)
# LPDG_REPORTS_DIR=../drift_reports

# Path where predictions.csv will be written by src/predict.py.
# Default: predictions.csv (relative to backend/)
# LPDG_PREDICTIONS_PATH=predictions.csv

# ── App metadata (rarely need changing) ────────────────────────────────────────
# LPDG_APP_NAME=LPDG Gateway Prioritization API
# LPDG_APP_VERSION=1.0.0
